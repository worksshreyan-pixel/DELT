# ==============================================================================
# DELT — Environment Configuration
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local to version control.
# Server-only keys MUST NEVER be prefixed with NEXT_PUBLIC_.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Public Supabase URL & Anon Key (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only Supabase Service Role Key (NEVER expose to browser / client code)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# Razorpay Configuration
# ------------------------------------------------------------------------------
# Razorpay Key ID (publicly used for Checkout modal)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Server-only Razorpay Key Secret (NEVER expose to browser / client code)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Server-only Razorpay Webhook Secret for signature validation
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# Email Configuration (Resend)
# ------------------------------------------------------------------------------
# Server-only Resend API Key for sending client invitation and notification emails
RESEND_API_KEY=re_your_resend_api_key
# In development (before verifying a custom domain), use Resend's free test sender:
RESEND_FROM_EMAIL=DELT <onboarding@resend.dev>
# When you verify your own domain later, change to:
# RESEND_FROM_EMAIL=DELT <deals@yourcustomdomain.com>

# ------------------------------------------------------------------------------
# Application URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Video Processor Configuration (Render Service)
# ------------------------------------------------------------------------------
VIDEO_PROCESSOR_URL=https://delt-video-processor.onrender.com
# Server-only shared secret for Render authentication
VIDEO_PROCESSOR_SECRET=
